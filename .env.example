# Storefront environment (copy to .env.local). No secrets belong here:
# every VITE_* value is bundled into public JavaScript.

# --- Catalog source -------------------------------------------------------------------------------
# SET THIS to read products and categories from the backend API (milestone 1):
#   VITE_API_BASE_URL=http://localhost:4000
# Leave it UNSET to run on the bundled sample catalogue instead.
#
# There is no silent fallback: with this set, a backend that is down shows an error rather than
# quietly serving stale sample products.
VITE_API_BASE_URL=http://localhost:4000

# Fraction (0–1) of *mock* service calls that fail on purpose, to exercise error/retry states.
# Ignored for calls that go to the real API.
VITE_MOCK_FAILURE_RATE=0
